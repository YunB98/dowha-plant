# 컨테이너 시작 시 envsubst로 ${ORIGIN_DOMAIN}, ${ORIGIN_VERIFY_SECRET}만 치환된다.

# CloudFront가 붙인 X-Origin-Verify 헤더가 맞는지 (ADR 0021)
map $http_x_origin_verify $origin_ok {
    default                   0;
    "${ORIGIN_VERIFY_SECRET}" 1;
}

upstream api {
    server api:8000;
    keepalive 8;
}

upstream umami {
    server umami:3000;
}

# 이름이 다른 요청(IP 직접 접속 등)은 인증서를 보여주지 않고 끊는다.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${ORIGIN_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ORIGIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ORIGIN_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;

    # 비밀 헤더가 없으면 거부. CloudFront는 403을 404 페이지로 바꾸므로
    # 우리 배포에서 이 응답이 보이면 SSM 값과 CloudFront 설정이 어긋난 것이다.
    if ($origin_ok = 0) {
        return 403;
    }

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Origin-Verify "";

    location = /api/v1/inquiries {
        limit_req zone=inquiry burst=4 nodelay;
        proxy_pass http://api;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://api;
    }

    # 제한에 걸리면 API와 같은 오류 형식으로 (CloudFront는 429를 바꾸지 않는다)
    error_page 429 = @rate_limited;
    location @rate_limited {
        default_type application/json;
        charset utf-8;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"요청이 너무 많아요. 잠시 후 다시 시도해주세요."}}';
    }

    # QR 스캔 → FastAPI가 기록 후 302 (ADR 0013)
    location /q/ {
        proxy_pass http://api;
    }

    # Umami는 추적 스크립트와 수집 경로만 공개한다. 관리 화면은 SSM 포트 포워딩으로만 (ADR 0014)
    # 사이트에는 <script defer src="/umami/script.js" data-website-id="..."> 로 넣는다.
    # 추적 스크립트는 자기 주소 기준으로 /umami/api/send에 보낸다.
    location = /umami/script.js {
        proxy_pass http://umami/script.js;
    }

    location = /umami/api/send {
        proxy_pass http://umami/api/send;
    }

    location / {
        return 404;
    }
}
